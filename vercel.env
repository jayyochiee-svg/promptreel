# PromptReel environment file
# Vercel: Project → Settings → Environment Variables → Import .env
# The studio runs in demo mode if you skip this file.
# Uncomment a line only when you have a real value.

DISABLE_DEMO_ENGINE=0
OPENAI_MODEL=gpt-4o-mini
AUTO_MIGRATE=1
SHOT_CONCURRENCY=4
ENABLE_RATE_LIMIT=0
RATE_MAX_FILMS=12
RATE_MAX_SECONDS=1800
RATE_WINDOW_MINUTES=60
S3_REGION=auto
S3_PREFIX=videos
S3_FORCE_PATH_STYLE=false

